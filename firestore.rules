rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isLecturer() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'lecturer';
    }

    function ownsCourse(courseId) {
      return isLecturer()
        && get(/databases/$(database)/documents/courses/$(courseId)).data.lecturerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin() || isLecturer());
      allow create: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if signedIn();
      allow create: if isAdmin() ||
        (isLecturer() && request.resource.data.lecturerId == request.auth.uid);
      allow update: if isAdmin() ||
        (isLecturer() && resource.data.lecturerId == request.auth.uid &&
          request.resource.data.lecturerId == resource.data.lecturerId);
      allow delete: if isAdmin() ||
        (isLecturer() && resource.data.lecturerId == request.auth.uid);
    }

    match /departments/{departmentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create: if isAdmin() ||
        (isLecturer() && request.resource.data.postedBy == request.auth.uid);
      allow update, delete: if isAdmin() ||
        (isLecturer() && resource.data.postedBy == request.auth.uid);
    }

    match /materials/{materialId} {
      allow read: if signedIn();
      allow create: if isAdmin() ||
        (isLecturer() && request.resource.data.uploadedBy == request.auth.uid);
      allow update, delete: if isAdmin() ||
        (isLecturer() && resource.data.uploadedBy == request.auth.uid);
    }

    match /assignments/{assignmentId} {
      allow read: if isAdmin() || isLecturer() ||
        (signedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isAdmin() ||
        (isLecturer() && request.resource.data.lecturerId == request.auth.uid);
      allow update: if isAdmin() ||
        (signedIn() && resource.data.studentId == request.auth.uid &&
          request.resource.data.studentId == resource.data.studentId &&
          request.resource.data.lecturerId == resource.data.lecturerId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'submittedAt', 'submissionFile', 'submissionComments'
          ]));
      allow delete: if isAdmin() ||
        (isLecturer() && resource.data.lecturerId == request.auth.uid);
    }

    match /mcqs/{mcqId} {
      allow read: if signedIn();
      allow create: if isAdmin() ||
        (isLecturer() && request.resource.data.createdBy == request.auth.uid && ownsCourse(request.resource.data.courseId));
      allow update, delete: if isAdmin() ||
        (isLecturer() && resource.data.createdBy == request.auth.uid);
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAdmin() || isLecturer() ||
        (signedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isAdmin() ||
        (signedIn() && request.resource.data.studentId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin() ||
        (signedIn() && resource.data.studentId == request.auth.uid);
    }

    match /grades/{gradeId} {
      allow read: if isAdmin() || isLecturer() ||
        (signedIn() && resource.data.studentId == request.auth.uid && resource.data.status == 'published');
      allow create: if isAdmin() || ownsCourse(request.resource.data.courseId);
      allow update: if isAdmin() ||
        (ownsCourse(resource.data.courseId) && request.resource.data.courseId == resource.data.courseId);
      allow delete: if isAdmin() || ownsCourse(resource.data.courseId);
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin() || isLecturer() ||
        (signedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isAdmin() || ownsCourse(request.resource.data.courseId);
      allow update, delete: if isAdmin() || ownsCourse(resource.data.courseId);
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || isLecturer() ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin() || isLecturer();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}